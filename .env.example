# ============================================================================
# CIRO-SCAN TELEGRAM BOT CONFIGURATION EXAMPLE
# ============================================================================

# Token Bot Telegram dari BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID Pemilik (Whitelist keamanan)
TELEGRAM_CHAT_ID=1936436999

# Kunci Master Enkripsi RAM Vault (AES-256-GCM) untuk secrets.enc
VAULT_KEY=ciro_scan_vault_key_2026_aes_gcm

# Mode Auto-Scan 24/7 Terus Menerus
AUTO_SCAN=false
AUTO_SCAN_MODE=feed
AUTO_SCAN_INTERVAL=60

# CATATAN KEAMANAN:
# GitHub PAT tidak disimpan dalam teks mentah di sini!
# Token disimpan terenkripsi AES-256-GCM di file 'secrets.enc'
# dan hanya didekripsi ke RAM proses saat bot berjalan.
# Kelola via Telegram: /pats, /set_pat <token...>, /clear_pat
